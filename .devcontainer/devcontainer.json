{
    "name": "manyfold Development Container",
    "image": "ghcr.io/rails/devcontainer/images/ruby:3.4.9",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        },
        "ghcr.io/rails/devcontainer/features/activestorage": {},
        "ghcr.io/itsmechlark/features/redis-server:1": {}
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get install -y libpq-dev libmariadb-dev libarchive13 libassimp-dev assimp-utils && corepack enable && bundle install && yarn install",
    "postStartCommand": "redis-server --daemonize yes",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "Shopify.ruby-lsp"
            ]
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder}/tmp/libraries,target=/libraries,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "SHELL": "/bin/bash",
        "RAILS_ENV": "development",
        "NODE_ENV": "development",
        "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
    },
    "forwardPorts": [
        3214
    ],
    "portsAttributes": {
        "3214": {
            "label": "Rails Server",
            "onAutoForward": "notify"
        }
    }
}
